# ─── Deployment ───────────────────────────────────────────────────────────────
IMAGE_OWNER=ngthotuan
APP_VERSION=latest

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8080
FRONTEND_URL=https://your-domain.com

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=                 # openssl rand -hex 32
ENCRYPTION_KEY=             # exactly 32 bytes — DO NOT change after channels are connected

# ─── Database / Redis ─────────────────────────────────────────────────────────
# URL-encode special chars in passwords (@ → %40, ! → %21, # → %23, ...).
DATABASE_URL=postgres://mmo:CHANGE_ME@127.0.0.1:5432/mmo?sslmode=disable
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mmo-media
R2_PUBLIC_URL=

# ─── AI APIs ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# AI provider: gemini | mock  (mock = deterministic, no network — hermetic tests)
AI_PROVIDER=gemini
AI_FALLBACK_TO_MOCK=true
GEMINI_MODEL=gemini-2.5-flash
# When true, ALL publishes are mocked (no real social API calls). Use for E2E tests.
PUBLISH_DRY_RUN=false

# ─── Media APIs ───────────────────────────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_API_KEY=

# ─── Social Media ─────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# YouTube Shorts publishing (Google OAuth2 — separate from YOUTUBE_API_KEY above)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=unlisted

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=            # openssl rand -hex 32
